# === Firebase Admin credentials ===
# Option A (recommended for Render): paste the ENTIRE service account JSON as one line here.
FIREBASE_CRED_JSON={"type":"service_account","project_id":"YOUR_PROJECT_ID","private_key_id":"xxx","private_key":"-----BEGIN PRIVATE KEY-----\nxxxx\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk@YOUR_PROJECT_ID.iam.gserviceaccount.com","client_id":"xxx","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}

# Option B (local dev): path to the downloaded serviceAccountKey.json file instead of the JSON blob above.
# FIREBASE_CRED_FILE=serviceAccountKey.json

# Firebase Storage bucket, e.g. your-project-id.appspot.com
FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.appspot.com

# Flask
FLASK_SECRET_KEY=change-this-to-a-random-secret-string
FLASK_ENV=production
PORT=5000

# Default owner login (seeded by seed.py) - change after first login
OWNER_EMAIL=owner@custudio.com
OWNER_PASSWORD=custudio123

# === Optional: Customer Portal push notifications (MODULE 9) ===
# Leave blank/commented to keep push notifications silently disabled - the
# rest of the app, including the Customer Portal itself, works fine without
# them. Generate both with: python generate_vapid_keys.py
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_CLAIMS_SUB=mailto:your-real-email@example.com
